# Claves de metabase/compose.yml para la instancia de Metabase de una organización (srtm-backend#206; plan,
# Decisión 2026-10-25: una instancia por organización). Van en el mismo archivo de la organización que ya tiene
# las claves del corte, ~/.config/srtm-analitica/<org>.env (modo 0600, nunca se versiona), en el servidor
# donde corre Metabase:
#
#   cat metabase/metabase.env.example >> ~/.config/srtm-analitica/<org>.env
#   chmod 600 ~/.config/srtm-analitica/<org>.env
#
# Cada organización tiene su propio METABASE_PUERTO (3310, 3311, ...), su METABASE_PG_PASSWORD y su
# MB_ENCRYPTION_SECRET_KEY. MB_ENCRYPTION_SECRET_KEY cifra las credenciales que Metabase guarda; se genera una
# vez con
#   openssl rand -hex 32
# y no se cambia después (con otra clave, Metabase ya no lee lo que cifró con la anterior).
#
# La instancia monta solo /srv/srtm-metabase/<org>/duckdb (donde `make duckdb ORG=<org>` deja <org>.duckdb) y
# respalda en /srv/srtm-metabase/<org>/respaldos. Opcionales: METABASE_RESPALDOS_DIR (otra carpeta de
# respaldos), METABASE_SITE_URL y METABASE_URL (la que usan provisionar.py y humo.py; por omisión
# http://127.0.0.1:<METABASE_PUERTO>, el mismo puerto que reenvía el túnel SSH).
METABASE_PG_PASSWORD=cambiar
MB_ENCRYPTION_SECRET_KEY=NO-USAR-generar-con-openssl-rand-hex-32
METABASE_RESPALDOS_S3=
METABASE_PUERTO=3310

# Variables de metabase/compose.yml (srtm-backend#206). Copiar a metabase.env (no se versiona; va a
# B/.gitignore) y poner valores reales en el servidor:
#
#   cp metabase/metabase.env.example metabase/metabase.env
#
METABASE_PG_PASSWORD=cambiar
MB_ENCRYPTION_SECRET_KEY=cambiar-por-32-caracteres-o-mas
METABASE_DUCKDB_DIR=/srv/srtm-metabase/duckdb
METABASE_RESPALDOS_DIR=/srv/srtm-metabase/respaldos
METABASE_RESPALDOS_S3=
METABASE_PUERTO=3310

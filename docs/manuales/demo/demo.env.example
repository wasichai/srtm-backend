# Variables de la demostración de los manuales (docs/manuales/demo). Copiar a demo.env (no se versiona):
#
#   cp docs/manuales/demo/demo.env.example docs/manuales/demo/demo.env
#
# Todo es local y desechable. Ningún valor de aquí sirve fuera de la demo.

# --- Base (compose.demo.yml: proyecto srtm-docs, 127.0.0.1:5447, base srtm_demo) ---
WASICHAI_DB_HOST=127.0.0.1
WASICHAI_DB_PORT=5447
WASICHAI_DB_NAME=srtm_demo
WASICHAI_DB_USERNAME=srtm
WASICHAI_DB_PASSWORD=srtm
SRTM_DEMO_PG_PORT=5447

# --- Core de la demo: otro puerto que el 8090 de desarrollo ---
SERVER_PORT=8098
WASICHAI_SEED_DEV=true
WASICHAI_JWT_SECRET=srtm-demo-solo-local-0123456789abcdef
SRTM_EMISION_DIR=./build/demo/emisiones

# --- Scripts (model/*.py y demo/sembrar_demo.py) ---
WASICHAI_CORE=http://localhost:8098
WASICHAI_EMAIL=admin@wasichai.local
WASICHAI_PASSWORD=admin

# --- Clave de las cuentas de los perfiles demo (demo/perfiles.json). Solo para la demo local ---
SRTM_DEMO_PASSWORD=Demo-2026

# --- Front de la demo (srtm-ui): yarn dev --port 5183 con este backend ---
WASICHAI_API_URL=http://localhost:8098
SRTM_DEMO_UI=http://localhost:5183

# --- Zona horaria del Core: la de Lima, como la del navegador de las capturas (fechas del mismo día) ---
TZ=America/Lima
JAVA_TOOL_OPTIONS=-Duser.timezone=America/Lima

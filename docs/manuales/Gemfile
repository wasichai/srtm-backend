# Las gemas con que se construyen los manuales, a versiones fijas (Gemfile.lock). Las usa el CI
# (.github/actions/manuales); en local basta con tener asciidoctor y asciidoctor-pdf instalados.
source "https://rubygems.org"

gem "asciidoctor", "2.0.26"
gem "asciidoctor-pdf", "2.3.15"
gem "rouge", "4.2.1"
# gemas que Ruby 4.0 ya no trae entre las gemas por omisión y que asciidoctor-pdf carga
gem "bigdecimal"
gem "logger"
gem "matrix"
gem "ostruct"
gem "rexml"

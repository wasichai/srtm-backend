# cp srtm.example.env srtm.env (srtm.env no se versiona)
WASICHAI_DB_HOST=pg
WASICHAI_DB_PORT=5432
WASICHAI_DB_NAME=srtm
WASICHAI_DB_USERNAME=srtm
WASICHAI_DB_PASSWORD=<la SRTM_DB_PASSWORD de pg.env>
# la semilla de dev crea la organización Demo y admin@wasichai.local / admin: solo en pruebas
WASICHAI_SEED_DEV=true
WASICHAI_JWT_SECRET=<32 bytes o más: openssl rand -hex 32>
WASICHAI_GEOSERVER_ENABLED=false
# el volumen srtm-data de compose.yml
SRTM_ARCHIVOS_DIR=/app/data/archivos
SRTM_EMISION_DIR=/app/data/emisiones
SRTM_EMISION_TRABAJADORES=1
JAVA_TOOL_OPTIONS=-Xmx1536m

# brecha: una entrada por organización, con la cuenta que imprime crear_cuenta_srtm.py en catastro-core. la url es la
# de la red de compose. una clave que es el slug de srtm (solo letras y números) nombra la organización; un slug con
# guion, o un id, va en _ORGANIZACION (el id de srtm, no el de catastro)
SRTM_CATASTRO_ENABLED=true
SRTM_CATASTRO_ORGANIZACIONES_DEMO_URL=http://catastro-core:8091
SRTM_CATASTRO_ORGANIZACIONES_DEMO_CLIENT_ID=<clientId>
SRTM_CATASTRO_ORGANIZACIONES_DEMO_CLIENT_SECRET=<clientSecret>
SRTM_CATASTRO_ORGANIZACIONES_ICA_URL=http://catastro-core:8091
SRTM_CATASTRO_ORGANIZACIONES_ICA_CLIENT_ID=<clientId>
SRTM_CATASTRO_ORGANIZACIONES_ICA_CLIENT_SECRET=<clientSecret>
# SRTM_CATASTRO_ORGANIZACIONES_ICAPRUEBA_ORGANIZACION=<id en srtm de ica-prueba>
# SRTM_CATASTRO_ORGANIZACIONES_ICAPRUEBA_URL=http://catastro-core:8091
# SRTM_CATASTRO_ORGANIZACIONES_ICAPRUEBA_CLIENT_ID=<clientId>
# SRTM_CATASTRO_ORGANIZACIONES_ICAPRUEBA_CLIENT_SECRET=<clientSecret>

# cp catastro.example.env catastro.env (catastro.env no se versiona)
WASICHAI_DB_HOST=pg
WASICHAI_DB_PORT=5432
WASICHAI_DB_NAME=catastro
WASICHAI_DB_USERNAME=catastro
WASICHAI_DB_PASSWORD=<la CATASTRO_DB_PASSWORD de pg.env>
WASICHAI_SEED_DEV=true
WASICHAI_JWT_SECRET=<otro secreto de 32 bytes o más>
WASICHAI_GEOSERVER_ENABLED=false
JAVA_TOOL_OPTIONS=-Xmx1536m

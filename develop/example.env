# Variables de ejemplo para desarrollar srtm-backend en local.
#
#   cp develop/example.env develop/.env      # develop/.env está en .gitignore: nunca se versiona
#   set -a; source develop/.env; set +a      # exporta las variables al shell actual
#   ./gradlew bootRun
#
# Guía completa: docs/develop/README.md

# --- Base de datos (compose.yml: postgis/postgis:18-3.6 en 127.0.0.1:5433, base/usuario/clave srtm) ---
WASICHAI_DB_HOST=localhost
WASICHAI_DB_PORT=5433
WASICHAI_DB_NAME=srtm
WASICHAI_DB_USERNAME=srtm
WASICHAI_DB_PASSWORD=srtm
# puerto que publica compose.yml (debe coincidir con WASICHAI_DB_PORT)
SRTM_PG_PORT=5433

# --- Seguridad ---
# >= 32 bytes. solo para desarrollo: en cualquier entorno real, uno propio y secreto
WASICHAI_JWT_SECRET=srtm-dev-only-secret-change-me-0123456789
# crea admin@wasichai.local / admin. apagarlo (false) fuera de desarrollo
WASICHAI_SEED_DEV=true

# --- Scripts de model/ (apply.py, import_predios.py) ---
WASICHAI_CORE=http://localhost:8090
WASICHAI_EMAIL=admin@wasichai.local
WASICHAI_PASSWORD=admin

# --- PIDE RENIEC (consulta de DNI). Apagada por defecto; las credenciales del convenio nunca se versionan ---
# SRTM_PIDE_RENIEC_ENABLED=true
# SRTM_PIDE_RENIEC_DNI_USUARIO=<dni del usuario del convenio>
# SRTM_PIDE_RENIEC_RUC_USUARIO=<ruc de la municipalidad>
# SRTM_PIDE_RENIEC_PASSWORD=<clave>

# --- Emisión masiva. Opcionales: estos son los valores por defecto ---
# almacén de los archivos de las emisiones (local: en el disco, bajo SRTM_EMISION_DIR; s3: en un bucket, sin volumen)
# SRTM_EMISION_ALMACEN=local
# raíz del almacén local. en producción, un volumen persistente y privado
# SRTM_EMISION_DIR=./data/emisiones
# archivos de trabajo de esta instancia (el .part de un lote, los .partes- de su PDF, el ensamblado-), antes de pasar
# al almacén. locales de cada instancia: nunca un volumen compartido
# SRTM_EMISION_TEMPORALES=/tmp/srtm-emision
# contribuyentes por lote
# SRTM_EMISION_LOTE=100
# trabajadores de esta instancia: auto (según núcleos y memoria) o un número; 0 no corre ninguno
# SRTM_EMISION_TRABAJADORES=auto
# cuánto espera un trabajador sin trabajo antes de volver a mirar
# SRTM_EMISION_ESPERA=5s
# un lote o un ensamblado cuya instancia dejó de latir hace este tiempo lo retoma otra
# SRTM_EMISION_LEASE=2m
# tomas de un lote antes de quedar FALLIDO
# SRTM_EMISION_INTENTOS=3

# --- Emisión masiva en S3 (SRTM_EMISION_ALMACEN=s3). Para probar con el MinIO de compose.yml:
#     docker compose --profile s3 up -d    (crea el bucket srtm-emisiones; consola en http://localhost:9001) ---
# SRTM_EMISION_ALMACEN=s3
# bucket (obligatorio con s3)
# SRTM_EMISION_S3_BUCKET=srtm-emisiones
# sin región: la de la cadena del SDK (AWS_REGION); contra otro endpoint, us-east-1
# SRTM_EMISION_S3_REGION=
# otro endpoint que el de AWS (MinIO), por path-style. vacío en AWS
# SRTM_EMISION_S3_ENDPOINT=http://localhost:9000
# las claves van debajo de este prefijo (vacío: en la raíz del bucket)
# SRTM_EMISION_S3_PREFIJO=srtm/emisiones
# credenciales por la cadena por defecto del SDK; con el MinIO local, su usuario y clave
# AWS_ACCESS_KEY_ID=srtm
# AWS_SECRET_ACCESS_KEY=srtm-minio

# --- GitHub Packages (librerías wasichai). Opcional si ya están en ~/.gradle/gradle.properties (gpr.user/gpr.key) ---
# GITHUB_ACTOR=<usuario de github>
# GITHUB_TOKEN=<PAT con read:packages>

# --- Tests de integración contra una base externa (solo con Docker remoto). El nombre debe terminar en _test ---
# WASICHAI_TEST_DB_HOST=localhost
# WASICHAI_TEST_DB_PORT=5443
# WASICHAI_TEST_DB_NAME=srtm_test
# WASICHAI_TEST_DB_USERNAME=srtm
# WASICHAI_TEST_DB_PASSWORD=<clave>

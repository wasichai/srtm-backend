{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "include-component-in-tag": false,
    "packages": {
        ".": {
            "release-type": "simple",
            "package-name": "srtm-backend",
            "changelog-path": "CHANGELOG.md",
            "bump-minor-pre-major": true,
            "release-as": "1.0.0",
            "extra-files": [
                "gradle.properties",
                "docs/manuales/atributos.adoc",
                {
                    "type": "json",
                    "path": "docs/presentaciones/src/generado/edicion.json",
                    "jsonpath": "$.version"
                }
            ]
        }
    }
}
